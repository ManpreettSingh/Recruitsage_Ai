{
  "manifest_version": 3,
  "name": "Recruit Copilot - Placement Intelligence",
  "version": "1.3.0",
  "description": "Placement intelligence copilot for college students. Company research, red-flag auditing, past interview questions, and prep.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://recruit.thapar.edu/*",
    "https://*.thapar.edu/*",
    "https://*.nip.io/*",
    "https://us.i.posthog.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "Open Recruit Copilot Side Panel",
    "default_icon": {
      "16": "icons/recruitcopilot_icon16.png",
      "32": "icons/recruitcopilot_icon32.png",
      "48": "icons/recruitcopilot_icon48.png",
      "128": "icons/recruitcopilot_icon128.png"
    }
  },
  "icons": {
    "16": "icons/recruitcopilot_icon16.png",
    "32": "icons/recruitcopilot_icon32.png",
    "48": "icons/recruitcopilot_icon48.png",
    "128": "icons/recruitcopilot_icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://recruit.thapar.edu/*",
        "https://*.thapar.edu/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": [
        "https://recruit.thapar.edu/*",
        "https://*.thapar.edu/*"
      ]
    }
  ]
}
