# ==============================================================================
# RecruitSage / Recruit Copilot - Production Git Ignore Configuration
# ==============================================================================

# --- Secrets, API Keys & Environment Configuration ---
.env
.env.*
*.env
**/.env
backend/.env
backend/**/.env

# --- Private Keys, Certificates & SSH Deploy Keys ---
*.pem
*.key
*.pub
id_*
**/id_*
backend/deploy/id_*
deploy/id_*
*.p12
*.pfx
*.cert
*.crt

# --- AWS & Cloud Provider Credentials ---
.aws/
credentials
aws_credentials

# --- Python Environments & Bytecode ---
__pycache__/
**/*__pycache__*
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Testing, Linting & Coverage ---
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/
.ruff_cache/
.mypy_cache/

# --- Temporary Files, Logs & Scrapes ---
*.log
logs/
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
scratch/
**/scratch/

# --- Dynamic Caches & Benchmark Artifacts ---
data/placement_master_cache.json
data/*_cache.json
scripts/benchmark_results.json

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- IDEs & Code Editors ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.project
.pydevproject
.settings/

# --- Node / Frontend Build Artifacts (if generated) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Package & Release Archives ---
*.zip
*.tar.gz
*.tgz
